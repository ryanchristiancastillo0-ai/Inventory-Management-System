# ==========================================================
# INVENTORY MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values.
# ==========================================================

# -------------------------
# BREVO (EMAIL)
# Brevo dashboard > SMTP & API > API Keys > v3 API key
# -------------------------
BREVO_API_KEY=

# "From" identity for all transactional emails.
# This email address must be added as a VERIFIED sender
# in your Brevo account (Senders & IP page).
MAIL_FROM_EMAIL=no-reply@inventoryhub.com
MAIL_FROM_NAME="Inventory Hub"

# Connection timeout in seconds for Brevo API calls.
BREVO_TIMEOUT=10

# -------------------------
# UNISMS (SMS — OTP codes)
# unismsapi.com > API > secret key
# HTTP Basic auth (key as username, empty password).
# Default Sender ID "Unisoft" supports Globe, TM and DITO
# (no Smart / TNT / Sun).
# -------------------------
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=Unisoft

# Optional: request timeouts in seconds.
UNISMS_TIMEOUT=15
UNISMS_CONNECT_TIMEOUT=10
